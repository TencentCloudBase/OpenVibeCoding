# Root template — run ./init.sh to generate .env.local and packages/server/.env
# See README「本地启动」and docs/setup.md for details.

# ==================== Required (init generates) ====================
JWE_SECRET=
ENCRYPTION_KEY=
NEXT_PUBLIC_AUTH_PROVIDERS=local

# ==================== CloudBase (also copied to packages/server/.env) ====================
TCB_SECRET_ID=
TCB_SECRET_KEY=
# TCB_ENV_ID=
# TCB_REGION=ap-shanghai

# ==================== Optional ====================
# TCB_PROVISION_MODE=shared          # shared | isolated | task — user CloudBase env
# MAX_MESSAGES_PER_DAY=50
# MAX_SANDBOX_DURATION=300

# CodeBuddy: CODEBUDDY_API_KEY or OAuth trio — see init / README
# GitHub OAuth: GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET

# TCR (pnpm setup:tcr): TCR_NAMESPACE, TCR_PASSWORD, TCR_IMAGE

# ==================== packages/server/.env (not this file) ====================
# Runtime: TCB_*, TCB_API_KEY, CODEBUDDY_*, optional SANDBOX_INSTANCE_MODE,
# GIT_ARCHIVE_* / GIT_PERSONAL_AUTH. Template: packages/server/.env.example
# Do NOT set STATEFUL_TOOL_ID or STATEFUL_SANDBOX_ID unless debugging scripts.
